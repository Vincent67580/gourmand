{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie - Gourmand{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 800px;">

    {# En-tête avec titre et bouton de retour #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">✏️ Modifier la catégorie</h1>
        <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary">
            ⬅️ Retour à la liste
        </a>
    </div>

    {# Carte du formulaire #}
    <div class="card shadow-sm border-0 p-4">
        
        {# Formulaire principal de modification #}
        {{ include('category/_form.html.twig', {'button_label': '💾 Enregistrer les modifications'}) }}

        <hr class="my-4">

        {# Zone d'action dangereux (Suppression) #}
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Zone d'administration :</span>
            {{ include('category/_delete_form.html.twig') }}
        </div>

    </div>

</div>
{% endblock %}