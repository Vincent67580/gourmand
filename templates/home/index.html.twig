{% extends 'base.html.twig' %}

{% block title %}Accueil - Gourmand{% endblock %}

{% block body %}
{# Bannière d'accueil #}
<div class="p-3 mb-4 bg-white rounded-5 shadow-sm text-center">
    <h1 class="display-5 fw-bold text-primary">Découvrez des recettes</h1>
    <p class="lead text-muted">Trouvez l'inspiration pour vos prochains repas parmi ma sélection.</p>
</div>

{# Barre de recherche par mot-clé #}
<div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <form method="get" action="{{ path('app_home') }}" class="d-flex gap-2">
            <input type="text" 
                   name="search" 
                   class="form-control" 
                   placeholder="Rechercher une recette (ex: Tartiflette, Poulet...)" 
                   value="{{ searchTerm }}">
            <button type="submit" class="btn btn-primary">🔍 Rechercher</button>
            {% if searchTerm or currentCategory %}
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">Réinitialiser</a>
            {% endif %}
        </form>
    </div>
</div>

{# Barre de filtres par catégorie #}
<div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
    <a href="{{ path('app_home') }}" 
       class="btn {{ currentCategory is null ? 'btn-primary' : 'btn-outline-primary' }}">
        Toutes les recettes
    </a>
    
    {% for category in categories %}
        <a href="{{ path('app_home', {'category': category.id}) }}" 
           class="btn {{ currentCategory == category.id ? 'btn-primary' : 'btn-outline-primary' }}">
            {{ category.name }}
        </a>
    {% endfor %}
</div>


{# Section : Recettes les plus vues #}
{% if topRecipes is not empty and currentPage == 1 and not searchTerm and not currentCategory %}
    <div class="mb-5">
        <h2 class="h4 mb-3 text-primary fw-bold">🔥 Les plus populaires</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for recipe in topRecipes %}
                <div class="col">
                    <div class="card h-100 border-primary shadow-sm bg-light-subtle">
                        <div class="card-body d-flex flex-column">
                            
                            {# En-tête : Top + Catégorie à gauche | Vues à droite #}
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-danger">Top {{ loop.index }}</span>
                                <span class="badge bg-secondary">{{ recipe.category.name ?? 'Non classé' }}</span>
                                <span class="badge bg-light text-dark border ms-auto">👁️ {{ recipe.views ?? 0 }} vues</span>
                            </div>

                            <h5 class="card-title fw-bold fs-6">{{ recipe.title }}</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                {{ recipe.description|slice(0, 80) }}...
                            </p>

                            {# Pied de la carte #}
                            <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                                <small class="text-muted">🍽️ {{ recipe.servings }} pers.</small>
                                <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-outline-primary btn-sm">
                                    Voir la recette
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <hr class="my-4">
{% endif %}

{# Grille de cartes pour l'ensemble des recettes #}
<h2 class="h4 mb-3 text-primary fw-bold">Les recettes</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    {% for recipe in recipes %}
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    
                    {# En-tête de la carte #}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary">{{ recipe.category.name ?? 'Non classé' }}</span>
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-muted">⏱️ {{ recipe.preparationTime + recipe.cookingTime }} min</small>
                            <span class="badge bg-light text-dark border">
                                👁️ {{ recipe.views ?? 0 }}
                            </span>
                        </div>
                    </div>

                    <h5 class="card-title fw-bold">{{ recipe.title }}</h5>
                    <p class="card-text text-muted flex-grow-1">
                        {{ recipe.description|slice(0, 100) }}...
                    </p>

                    {# Pied de la carte #}
                    <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">🍽️ {{ recipe.servings }} pers.</small>
                        <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-outline-primary btn-sm">
                            Voir la recette
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <p class="text-muted">Aucune recette trouvée dans cette catégorie.</p>
        </div>
    {% endfor %}
</div>

{# Pagination Bootstrap avec fenêtre glissante (sliding pagination) #}
{% if maxPages > 1 %}
    <nav aria-label="Navigation des recettes" class="mt-4">
        <ul class="pagination justify-content-center">
            
            {# Bouton Précédent #}
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ path('app_home', {page: currentPage - 1, search: searchTerm, category: currentCategory}) }}">Précédent</a>
            </li>

            {# Définition du rayon (combien de pages afficher autour de la page courante) #}
            {% set nearbyPagesLimit = 2 %}

            {% for i in 1..maxPages %}
                {% if i == 1 or i == maxPages or (i >= currentPage - nearbyPagesLimit and i <= currentPage + nearbyPagesLimit) %}
                    <li class="page-item {% if currentPage == i %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_home', {page: i, search: searchTerm, category: currentCategory}) }}">{{ i }}</a>
                    </li>
                {% elseif i == currentPage - nearbyPagesLimit - 1 or i == currentPage + nearbyPagesLimit + 1 %}
                    <li class="page-item disabled">
                        <span class="page-link">…</span>
                    </li>
                {% endif %}
            {% endfor %}

            {# Bouton Suivant #}
            <li class="page-item {% if currentPage == maxPages %}disabled{% endif %}">
                <a class="page-link" href="{{ path('app_home', {page: currentPage + 1, search: searchTerm, category: currentCategory}) }}">Suivant</a>
            </li>

        </ul>
    </nav>
{% endif %}



{% endblock %}