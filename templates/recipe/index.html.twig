{% extends 'base.html.twig' %}

{% block title %}Gestion des recettes - Gourmand{% endblock %}

{% block body %}
<div class="container py-4">

    {# En-tête avec titre et bouton de création #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Gestion des recettes</h1>
        <a href="{{ path('app_recipe_new') }}" class="btn btn-success shadow-sm">
            ➕ Ajouter une recette
        </a>
    </div>

    {# Tableau stylisé Bootstrap #}
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 60px;">ID</th>
                        <th scope="col">Titre</th>
                        <th scope="col">Catégorie</th>
                        <th scope="col">Description</th>
                        <th scope="col" class="text-center">Prépa</th>
                        <th scope="col" class="text-center">Cuisson</th>
                        <th scope="col" class="text-center">Portions</th>
                        <th scope="col" class="text-end" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for recipe in recipes %}
                    <tr>
                        <td class="fw-bold text-muted">{{ recipe.id }}</td>
                        <td class="fw-semibold">{{ recipe.title }}</td>
                        <td>
                            <span class="badge bg-secondary">
                                {{ recipe.category.name ?? 'Non classé' }}
                            </span>
                        </td>
                        <td class="text-muted">
                            {{ recipe.description|slice(0, 50) }}...
                        </td>
                        <td class="text-center">⏱️ {{ recipe.preparationTime }} min</td>
                        <td class="text-center">🍳 {{ recipe.cookingTime }} min</td>
                        <td class="text-center">🍽️ {{ recipe.servings }}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-outline-primary" title="Voir les détails">
                                    👁️ Voir
                                </a>
                                <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="btn btn-outline-warning" title="Modifier">
                                    ✏️ Éditer
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Aucune recette enregistrée pour le moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}